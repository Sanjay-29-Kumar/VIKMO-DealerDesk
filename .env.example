# ==============================================================================
# VIKMO DealerDesk — Local Environment Variables Template
# ==============================================================================
# Copy this file to .env and fill in your values. Never commit .env to git.
# ==============================================================================

# Required: PostgreSQL connection URL (e.g., Neon Cloud or local PostgreSQL)
DATABASE_URL=postgres://username:password@localhost:5432/dealerdesk

# Required for Part B: Supplier Catalog Sync (point at mock supplier)
SUPPLIER_API_URL=http://127.0.0.1:8099
SUPPLIER_API_KEY=dev-supplier-key

# Django Configuration
DJANGO_SECRET_KEY=change-me-to-a-secure-random-secret-key
DJANGO_DEBUG=1
